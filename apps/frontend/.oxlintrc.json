{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["build/**", "node_modules/**"],
  "env": {
    "builtin": true,
    "browser": true
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "oxc/no-map-spread": "off"
  }
}
